index 0000000..30d4490
--- /dev/null
+++ b/sdk/HIDMaestro.Core/Internal/ProfileJsonContext.cs
@@ -0,0 +1,28 @@
+using System.Text.Json.Serialization;
+
+namespace HIDMaestro.Internal;
+
+/// <summary>HOJA local build: the profile schema's JSON metadata, generated at compile time, so the
+/// profile catalog also loads in a NativeAOT app, where reflection-based JSON has no code for the
+/// value-type properties and every profile would fail to parse. The layouts are listed because
+/// HMLayoutJsonConverter reads each kind as its own type.</summary>
+[JsonSerializable(typeof(ControllerProfile))]
