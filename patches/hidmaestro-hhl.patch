     /// creating the section on first call. Thread-safe via per-call lock
     /// callers can issue concurrent EnsureInputMapping requests for distinct
     /// controllerIndex values without races. Idempotent for the same index.</summary>
+    /// <summary>HOJA local build: whether another process's controller already holds this index.
+    /// The sections are machine-wide and every SDK consumer numbers from 0, so two HIDMaestro apps
+    /// running at once would otherwise share one input section, each device reading the other's
+    /// reports.</summary>
+    public static bool IsIndexTakenElsewhere(int controllerIndex)
+    {
+        lock (s_inputViews)
+            if (s_inputViews.ContainsKey(controllerIndex))
+                return false; // This process's own
+        IntPtr h = OpenFileMappingW(FILE_MAP_READ, false, $@"Global\HIDMaestroInput{controllerIndex}");
+        if (h == IntPtr.Zero)
+            return false;
+        CloseHandle(h);
+        return true;
+    }
+
+    /// <summary>HOJA local build: whether another process has a controller on any of the first
+    /// <paramref name="count"/> indexes, i.e. another HIDMaestro app is running one.</summary>
+    public static bool AnyIndexTakenElsewhere(int count = 32)
+    {
+        for (int i = 0; i < count; i++)
+            if (IsIndexTakenElsewhere(i))
+                return true;
+        return false;
+    }
+
